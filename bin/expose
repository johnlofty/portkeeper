#!/bin/sh
# local-gateway remote client -- ask the Mac to open or drop a port mapping.
#
# Runs on the remote dev box. Talks to the gatewayd public API on the Mac at
# 127.0.0.1:$LG_PORT (9996), reachable from here only because the Mac's SSH
# config carries `RemoteForward 9996 localhost:9996` (see ssh/config in the
# dotfiles repo). The daemon adds the real forward to its own SSH ControlMaster.
#
# There is no authentication, by design. The API this talks to is a deliberately
# small public capability: create a local-forward, list, close. It is kept safe
# by what it refuses to do, not by a secret -- a secret copied onto this box
# would be readable by every process here, which is the threat it would have
# been nominally guarding against.
#
# Anything more powerful -- remote-forwards, opening a browser on the Mac,
# configuration -- is an admin capability and lives behind a password login in
# the console on the Mac. This script never authenticates and never goes there.
#
# Deliberately POSIX sh rather than a compiled client: this box has no Go
# toolchain, so a binary would mean cross-compiling and either committing it to
# git or scp'ing on every change. The client is a thin HTTP wrapper -- it ships
# as a script and updates with a `git pull`.
#
# Usage: expose --help

set -u

LG_PORT="${LG_PORT:-9996}"
LG_URL="${LG_URL:-http://127.0.0.1:${LG_PORT}}"
LG_TIMEOUT="${LG_TIMEOUT:-5}"

# Which host this box is, as the Mac's ssh config names it.
#
# Deliberately NOT guessed. This box's own hostname is not the alias: `hostname -s` here
# reports "code-server" while the Mac's ssh config calls it "code", so matching one against
# the other always fell through to a hardcoded default. With a single host that default
# happened to be right; with several it would ask the Mac to forward a port on the WRONG
# MACHINE and succeed, because the alias it named is a perfectly valid one.
#
# So send nothing unless something authoritative told us. The daemon fills in the only
# public host it has, and says so plainly when there is more than one to choose from.
LG_HOST_FILE="${LG_HOST_FILE:-$HOME/.config/local-gateway/host}"

# The only direction this client can create. Remote-forwards are admin-only.
DIRECTION="local-forward"

usage() {
  cat <<'EOF'
expose -- make a port on this host reachable on the Mac

  expose <port> [--label NAME] [--ttl SECONDS]
                            Forward <port>; prints the Mac URL.
  expose --list             Show the mappings the daemon currently holds.
  expose --close <id|port>  Drop a mapping.
  expose --wait <port>      Forward, then hold; closes the mapping on Ctrl-C.
  expose --help

Options:
  --label NAME    Tag the mapping so `--list` is readable (e.g. mkdp, vite).
  --ttl SECONDS   Override the daemon's default lifetime.

  --close takes the id from `--list`, or a bare port.

Environment:
  LG_HOST         Override the host name reported to the daemon.
  LG_PORT         Public API port (default 9996).
  LG_URL          Override the daemon base URL outright.
  LG_TIMEOUT      HTTP timeout in seconds (default 5).

The URL goes to stdout on its own, so `url="$(expose 8530)"` works; everything
else is stderr.

This client only creates local-forwards (a port here, reachable on the Mac).
Remote-forwards and opening a browser on the Mac are admin operations -- use
the console on the Mac at http://127.0.0.1:9996/ for those.
EOF
}

die() {
  printf 'expose: %s\n' "$*" >&2
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

# A port we are willing to ask for. The daemon validates this again -- this
# check exists so a typo fails here with a useful message instead of a 400.
valid_port() {
  case "${1:-}" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ]
}

# Empty unless something authoritative said so. Never inferred from this box's hostname.
configured_host() {
  if [ -n "${LG_HOST:-}" ]; then
    printf '%s' "$LG_HOST"
    return
  fi
  [ -r "$LG_HOST_FILE" ] || return 0
  ch_v="$(sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$LG_HOST_FILE" 2>/dev/null)"
  case "$ch_v" in
    '' | '#'*) ;;
    *) printf '%s' "$ch_v" ;;
  esac
}

# Sets rq_body and rq_code. Returns non-zero only when the daemon could not be
# reached at all; an HTTP error is a successful round trip with a bad code.
request() {
  rq_method="$1"
  rq_path="$2"
  rq_data="${3:-}"

  rq_tmp="$(mktemp 2>/dev/null)" || die "could not create a temp file"

  if [ -n "$rq_data" ]; then
    rq_code="$(curl -s -m "$LG_TIMEOUT" -o "$rq_tmp" -w '%{http_code}' \
      -X "$rq_method" -H 'Content-Type: application/json' \
      -d "$rq_data" "${LG_URL}${rq_path}" 2>/dev/null)"
  else
    rq_code="$(curl -s -m "$LG_TIMEOUT" -o "$rq_tmp" -w '%{http_code}' \
      -X "$rq_method" "${LG_URL}${rq_path}" 2>/dev/null)"
  fi
  rq_rc=$?

  rq_body="$(cat "$rq_tmp" 2>/dev/null)"
  rm -f "$rq_tmp"

  return $rq_rc
}

# curl could not reach the daemon. Both plausible causes are invisible from
# this side of the tunnel, so name them rather than echoing a libcurl code.
die_unreachable() {
  du_rc="${1:-0}"
  case "$du_rc" in
    28) du_why="timed out after ${LG_TIMEOUT}s" ;;
    *) du_why="connection refused" ;;
  esac

  cat >&2 <<EOF
expose: cannot reach the local-gateway daemon at ${LG_URL} (${du_why})

The control channel is an SSH RemoteForward, so it exists only while the Mac
holds a connection to this host. Usually one of:

  * no SSH session from the Mac is up right now -- reconnect and retry
  * gatewayd is not running on the Mac:
      launchctl list | grep local-gateway
      tail /tmp/local-gateway.log
EOF
  exit 1
}

# The daemon answers errors as {"error": "..."}; fall back to the raw body if
# it ever answers with something else (a proxy, a panic).
die_http() {
  dh_msg=""
  if have jq; then
    dh_msg="$(printf '%s' "$rq_body" | jq -r '.error // empty' 2>/dev/null)"
  else
    dh_msg="$(printf '%s' "$rq_body" |
      sed -n 's/.*"error"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  fi
  [ -n "$dh_msg" ] || dh_msg="$(printf '%s' "$rq_body" | head -c 300)"
  [ -n "$dh_msg" ] || dh_msg="HTTP $rq_code"
  die "$dh_msg"
}

json_field() {
  printf '%s' "$rq_body" | jq -r "$1 // empty" 2>/dev/null
}

# Pulls one string field out without a JSON parser. The whitespace classes are
# not decoration: Go emits `"url":"x"` but anything else in the path (a proxy,
# a rewritten mock) may emit `"url": "x"`.
raw_field() {
  printf '%s' "$rq_body" |
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

build_payload() {
  bp_out=""
  if have jq; then
    bp_out="$(jq -nc \
      --arg d "$DIRECTION" \
      --argjson p "$port" \
      --arg h "$host" \
      --arg l "$label" \
      --arg r "$requester" \
      --argjson t "${ttl:-null}" \
      '{direction: $d, remote_port: $p, label: $l, requester: $r}
       + (if $h == "" then {} else {host: $h} end)
       + (if $t == null then {} else {ttl: $t} end)' 2>/dev/null)"
  fi
  if [ -z "$bp_out" ]; then
    # No jq: build it by hand. Strip the two characters that could break out of
    # a JSON string -- the fields that reach here are a label and a hostname.
    bp_label="$(printf '%s' "$label" | tr -d '\\"')"
    bp_requester="$(printf '%s' "$requester" | tr -d '\\"')"
    bp_out="{\"direction\":\"$DIRECTION\",\"remote_port\":$port"
    [ -n "$host" ] && bp_out="$bp_out,\"host\":\"$host\""
    bp_out="$bp_out,\"label\":\"$bp_label\",\"requester\":\"$bp_requester\""
    [ -n "${ttl:-}" ] && bp_out="$bp_out,\"ttl\":$ttl"
    bp_out="$bp_out}"
  fi
  printf '%s' "$bp_out"
}

do_forward() {
  request POST /api/forward "$(build_payload)" || die_unreachable $?
  [ "$rq_code" = "200" ] || die_http

  if have jq; then
    fw_url="$(json_field '.url')"
    fw_reused="$(json_field '.reused')"
    fw_local="$(json_field '.local_port')"
  else
    fw_url="$(raw_field url)"
    fw_reused=""
    fw_local=""
  fi

  [ -n "$fw_url" ] || die "daemon returned no URL: $rq_body"

  [ "$fw_reused" = "true" ] &&
    printf 'expose: reusing existing mapping\n' >&2

  # Never construct this URL locally: the daemon falls back to a different
  # local port when the mirrored one is already taken on the Mac.
  if [ -n "$fw_local" ] && [ "$fw_local" != "$port" ]; then
    printf 'expose: local port %s was taken on the Mac, using %s\n' "$port" "$fw_local" >&2
  fi

  printf '%s\n' "$fw_url"
}

# An id looks like `code:local-forward:8530`; a bare port never contains a colon.
# A bare port is only expanded into an id when we actually know the host -- otherwise it
# is sent as-is, and the daemon resolves it against the one public host it has. Building
# ":local-forward:8530" out of an empty host would just be a malformed id.
forward_id() {
  case "$1" in
    *:*) printf '%s' "$1" ;;
    *)
      if [ -n "$host" ]; then
        printf '%s:%s:%s' "$host" "$DIRECTION" "$1"
      else
        printf '%s' "$1"
      fi
      ;;
  esac
}

do_close() {
  request DELETE "/api/forward/$(forward_id "$target")" || die_unreachable $?
  [ "$rq_code" = "200" ] || die_http
  printf 'expose: closed %s\n' "$target" >&2
}

do_list() {
  request GET /api/forwards || die_unreachable $?
  [ "$rq_code" = "200" ] || die_http

  if ! have jq; then
    printf '%s\n' "$rq_body"
    return
  fi

  # The list can include remote-forwards created from the admin console, so FLOW
  # spells the direction out as an arrow between two named ends: which way a
  # mapping points stays readable without decoding a column heading.
  dl_rows="$(printf '%s' "$rq_body" | jq -r '
    def dur:
      if . == null then "-"
      elif . < 0 then "-"
      elif . < 60 then "\(.|floor)s"
      elif . < 3600 then "\(./60|floor)m"
      else "\(./3600|floor)h\((.%3600)/60|floor)m"
      end;
    def dash: if . == null or . == "" then "-" else . end;
    def flow:
      if (.direction // "local-forward") == "remote-forward"
      then "mac:\(.local_port) -> \(.host):\(.remote_port)"
      else "\(.host):\(.remote_port) -> mac:\(.local_port)"
      end;
    if length == 0 then empty else
      .[] | [
        (.id // "\(.host):\(.direction // "local-forward"):\(.remote_port)"),
        flow,
        (.label | dash),
        (.state | dash),
        (.age | dur),
        (if (.ttl // 0) == 0 then "-" else (.expires_in | dur) end),
        (.url | dash)
      ] | @tsv
    end' 2>/dev/null)"

  if [ -z "$dl_rows" ]; then
    printf 'No forwards.\n' >&2
    return
  fi

  dl_table="$(printf 'ID\tFLOW\tLABEL\tSTATE\tAGE\tEXPIRES\tURL\n%s\n' "$dl_rows")"
  if have column; then
    printf '%s\n' "$dl_table" | column -t -s "$(printf '\t')"
  else
    printf '%s\n' "$dl_table"
  fi
}

# --wait holds the terminal so that Ctrl-C tears the mapping back down: the
# ergonomics of `ssh -N -L`, but driven from this end.
wait_cleanup() {
  [ -n "${wc_done:-}" ] && return
  wc_done=1
  # Reap the parked sleep too, or it outlives us as an orphan for its full
  # duration -- one stray process per interrupted session.
  [ -n "${wc_sleep_pid:-}" ] && kill "$wc_sleep_pid" 2>/dev/null
  request DELETE "/api/forward/$(forward_id "$port")" >/dev/null 2>&1 || true
  printf '\nexpose: closed %s\n' "$port" >&2
}

do_wait() {
  do_forward
  trap wait_cleanup INT TERM EXIT
  printf 'expose: holding %s -- Ctrl-C to close\n' "$port" >&2
  # `sleep &` + `wait` so the trap fires immediately; a foreground sleep would
  # sit on the signal until it returns in some shells.
  while :; do
    sleep 86400 &
    wc_sleep_pid=$!
    wait "$wc_sleep_pid" || break
  done
}

action="forward"
port=""
target=""
label=""
ttl=""
host="$(configured_host)"
requester="${USER:-unknown}@$(hostname -s 2>/dev/null || echo remote):$PPID"

[ $# -gt 0 ] || {
  usage >&2
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --list | -l)
      action="list"
      ;;
    --close | -c)
      action="close"
      [ $# -ge 2 ] || die "--close needs an id or a port"
      target="$2"
      shift
      ;;
    --wait | -w)
      action="wait"
      [ $# -ge 2 ] || die "--wait needs a port"
      port="$2"
      shift
      ;;
    --open)
      # Still recognised rather than rejected as unknown: editor hooks written
      # against the old client pass it, and they deserve to be told why it went
      # rather than "unknown option".
      die "--open is an admin operation now; open the URL yourself, or use the console on the Mac at http://127.0.0.1:9996/"
      ;;
    --label)
      [ $# -ge 2 ] || die "--label needs a value"
      label="$2"
      shift
      ;;
    --ttl)
      [ $# -ge 2 ] || die "--ttl needs a value"
      case "$2" in
        '' | *[!0-9]*) die "--ttl must be a whole number of seconds" ;;
      esac
      ttl="$2"
      shift
      ;;
    --host)
      [ $# -ge 2 ] || die "--host needs a value"
      host="$2"
      shift
      ;;
    -*)
      die "unknown option: $1 (try --help)"
      ;;
    *)
      [ -z "$port" ] || die "unexpected argument: $1"
      port="$1"
      ;;
  esac
  shift
done

have curl || die "curl is required but not installed"

case "$action" in
  list)
    do_list
    ;;
  close)
    case "$target" in
      *:*) : ;; # an id from --list; the daemon validates it
      *) valid_port "$target" ||
        die "port must be a whole number in 1024-65535 (got '${target}')" ;;
    esac
    do_close
    ;;
  wait | forward)
    [ -n "$port" ] || die "which port? (try --help)"
    valid_port "$port" ||
      die "port must be a whole number in 1024-65535 (got '${port}')"
    if [ "$action" = "wait" ]; then do_wait; else do_forward; fi
    ;;
esac
