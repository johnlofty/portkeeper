<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.johnlofty.portkeeper</string>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO__/bin/portkeeperd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<!-- Aqua + Interactive: the daemon shells out to open(1) to put a URL in
	     the browser, which needs a GUI session context. Same reasoning as the
	     notify-relay agent, which needs it for osascript. -->
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<!-- launchd hands over a minimal PATH. The daemon shells out to ssh and
	     open, so spell it out rather than relying on the default. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/local-gateway.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/local-gateway.log</string>
</dict>
</plist>
